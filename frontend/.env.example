# API endpoint URL
# For local development, use /api (proxied via vite.config.ts)
# The production image defaults to the same-origin /api proxy. To use a
# cross-origin API, pass --build-arg VITE_API_URL=https://api.example.test
# when building the image; a runtime Nginx environment cannot alter Vite code.
VITE_API_URL=/api
# Local development only; production stays same-origin behind nginx.
VITE_PROXY_TARGET=http://localhost:8000
VITE_CATALOG_ENABLED=false

# Optional: Maximum nodes/links to render (client-side caps)
# VITE_MAX_RENDER_NODES=20000
# VITE_MAX_RENDER_LINKS=50000

# Optional: Camera animation duration in milliseconds when focusing on nodes
# VITE_CAMERA_ANIMATION_DURATION_MS=1500

# Instanced Three.js is the default. Set only as a temporary rollback to the
# legacy react-force-graph adapter during the staged cutover.
# VITE_USE_LEGACY_RENDERER=true
