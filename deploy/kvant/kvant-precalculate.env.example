# Root-owned, group onnwee, mode 0640 at /etc/clustr/kvant-precalculate.env.
# Never commit values.
# The release pipeline must replace this example with an immutable image digest.
CLUSTR_PRECALCULATE_IMAGE=ghcr.io/onnwee/reddit-cluster-map-precalculate@sha256:replace_me
ALMAZ_SSH_TARGET=almaz
ALMAZ_LOCAL_DB_PORT=15436
CLUSTR_WORKER_CPU_LIMIT=12
CLUSTR_WORKER_MEMORY_LIMIT=8g

# This reaches Almaz's loopback-only PostgreSQL listener through the temporary
# SSH tunnel. Percent-encode reserved characters in the password.
DATABASE_URL=postgres://replace_user:replace_password@127.0.0.1:15436/reddit_cluster?sslmode=disable

LOG_LEVEL=info
ENV=production
PRECALC_DB_MAX_OPEN_CONNS=5
DETAILED_GRAPH=false
LAYOUT_MAX_NODES=5000
LAYOUT_ITERATIONS=400
GRAPH_WORKSPACE_LINK_CAP=200000
GRAPH_COMMUNITY_MAX_NODES=10000
GRAPH_COMMUNITY_MAX_LINKS=50000
GRAPH_REVISION_NODE_CAP=100000
GRAPH_REVISION_LINK_CAP=200000
GRAPH_REVISION_SUBREDDIT_CAP=70000
GRAPH_REVISION_USER_CAP=30000
GRAPH_REVISION_POST_CAP=0
GRAPH_REVISION_COMMENT_CAP=0
GRAPH_REVISION_RETENTION=24
GRAPH_PUBLICATION_WORK_MEM_MB=256
