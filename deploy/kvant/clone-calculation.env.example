# Root-owned, group onnwee, mode 0640 at /etc/clustr/clone-calculation.env.
# Use an immutable local Docker image ID or repository digest.
CLUSTR_PRECALCULATE_IMAGE=sha256:replace_with_64_hex_image_id
KVANT_CLONE_ROOT=/mnt/data2/clustr-clones
CLUSTR_WORKER_CPU_LIMIT=16
CLUSTR_WORKER_MEMORY_LIMIT=8g

LOG_LEVEL=info
ENV=production
PRECALC_DB_MAX_OPEN_CONNS=5
DETAILED_GRAPH=false
LAYOUT_MAX_NODES=5000
LAYOUT_ITERATIONS=400
GRAPH_WORKSPACE_LINK_CAP=200000
GRAPH_COMMUNITY_MAX_NODES=10000
GRAPH_COMMUNITY_MAX_LINKS=50000
GRAPH_REVISION_NODE_CAP=100000
GRAPH_REVISION_LINK_CAP=200000
GRAPH_REVISION_SUBREDDIT_CAP=70000
GRAPH_REVISION_USER_CAP=30000
GRAPH_REVISION_POST_CAP=0
GRAPH_REVISION_COMMENT_CAP=0
GRAPH_REVISION_RETENTION=24
GRAPH_PUBLICATION_WORK_MEM_MB=256
SPATIAL_CATALOG_RETENTION=2
SPATIAL_CATALOG_WORK_MEM_MB=256
# Safe only when the clone PostgreSQL container has an enlarged /dev/shm.
SPATIAL_CATALOG_PARALLEL_WORKERS=12
