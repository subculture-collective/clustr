# Non-secret production clone pipeline configuration. Copy outside the repo and
# invoke scripts/clone/export-to-kvant.sh with its absolute path.
SOURCE_SSH_TARGET=almaz
SOURCE_EXPORT_ROOT=/mnt/spektr/server/projects/data/clustr-exports
SOURCE_POSTGRES_CONTAINER=pg17-clustr
SOURCE_DATABASE=reddit_cluster

KVANT_INCOMING_ROOT=/mnt/data2/clustr-exports
KVANT_CLONE_ROOT=/mnt/data2/clustr-clones
KVANT_CLONE_PORT=55440
KVANT_RESTORE_JOBS=8
KVANT_GPG_HOMEDIR=/etc/clustr/clone-gpg
# Full fingerprint of the unattended encryption-only key stored above.
KVANT_GPG_RECIPIENT=replace_with_full_fingerprint
